{% doc %}
  Renders `product.metafields.custom.technical_specs` as label/value rows.

  @param {object} block - The specs_table block

  @example
  {% render 'specs-table', block: block %}
{% enddoc %}

{%- if product.metafields.custom.technical_specs.value != blank -%}
  <div class="my-8 border-t border-(--specs-color)/10" style="--specs-color: {{ block.settings.text_color }}" {{ block.shopify_attributes }}>
    {%- for spec in product.metafields.custom.technical_specs.value -%}
      {%- assign parts = spec | split: ':' -%}
      <div class="mb-0 grid grid-cols-[1fr_2fr] border-b border-(--specs-color)/10 py-3 text-[length:clamp(0.9rem,1vw,1.1rem)]">
        <div class="text-[0.8em] font-semibold tracking-[0.05em] text-(--specs-color) uppercase">
          {{ parts[0] | strip }}
        </div>
        <div class="text-(--specs-color)/80">
          {{ parts[1] | default: parts[0] | strip }}
        </div>
      </div>
    {%- endfor -%}
  </div>
{%- endif -%}