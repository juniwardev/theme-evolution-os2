{% doc %}
  @param {object} block - The block object containing settings
{% enddoc %}

{%- liquid
  case block.settings.style
    when 'pill'
      assign badge_style_classes = 'rounded-[30px] border border-(--badge-color) bg-(--badge-color)/5 px-4'
    when 'underline'
      assign badge_style_classes = 'rounded-none border-b-2 border-(--badge-color)'
    else
      assign badge_style_classes = ''
  endcase
-%}

<div
  id="TrustBadge-{{ block.id }}"
  class="inline-flex items-center gap-3 py-2 text-[1.4rem] leading-none text-(--badge-color) transition-opacity duration-300 hover:opacity-80 {{ badge_style_classes }}"
  style="--badge-color: {{ block.settings.text_color }}"
  {{ block.shopify_attributes }}
>
  <span>✨</span>
  <span>{{ block.settings.heading | escape }}</span>
</div>