{% doc %}
  Renders information from a Material Metaobject.
  Designed for use on Product Details Pages (PDP) or other templates requiring material context.

  Architectural Notes:
  - Synchronized animation logic and high-specificity BEM styling with the main archive section.
  - Includes defensive integer casting of the sustainability rating for robust logic evaluation.

  @param {metaobject} material - The 'Material' metaobject value containing icon, name, story, and sustainability_rating.

  @example
  {% render 'material-info', material: product.metafields.custom.primary_material.value %}
{% enddoc %}

{%- if material != blank -%}
  {%- liquid
    assign rating_val = material.sustainability_rating.value | plus: 0
    assign rating_label = 'sections.material_spotlight.rating_label' | t
    assign rating_score_text = 'sections.material_spotlight.rating_score_text' | t: rating: rating_val
    assign rating_aria_label = 'sections.material_spotlight.rating_aria_label' | t: rating: rating_val
  -%}

  <div class="my-10 rounded-2xl border border-black/6 bg-white p-10 text-[#121212] shadow-[0_10px_30px_-10px_rgb(0_0_0/0.05)]">
    <div class="mb-8 flex items-center gap-6">
      {%- if material.icon.value != blank -%}
        <div class="size-15 shrink-0 overflow-hidden rounded-xl border border-black/5 bg-[#f4f4f4]">
          {{ material.icon.value | image_url: width: 120 | image_tag: loading: 'lazy', class: 'size-full object-cover' }}
        </div>
      {%- endif -%}
      <div>
        <span class="mb-1 block text-[0.75rem] font-extrabold tracking-[0.1em] text-[#a1a1a1] uppercase">{{ 'sections.material_info.subtitle' | t }}</span>
        <h3 class="m-0 text-[1.6rem] font-semibold text-[#121212]">{{ material.name.value | default: material.system.handle | capitalize }}</h3>
      </div>
    </div>
    {%- if material.story.value != blank -%}
      <div class="mb-8 text-[1.05rem] leading-[1.8] text-[#3d3d3d]">{{ material.story.value | escape | newline_to_br }}</div>
    {%- endif -%}

    {%- if rating_val > 0 -%}
      {% render 'sustainability-rating',
        rating: rating_val,
        label: rating_label,
        score_text: rating_score_text,
        aria_label: rating_aria_label
      %}
    {%- endif -%}
  </div>
{%- endif -%}
