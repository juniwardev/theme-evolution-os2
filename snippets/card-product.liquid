{% doc %}
  Renders a product card for sections/related-products.liquid.

  @param {product} card_product - The product to render
  @param {string} [media_aspect_ratio] - 'adapt', 'portrait' or 'square' (default square)
  @param {string} [image_shape] - 'default', 'arch', 'blob', 'chevronleft', 'chevronright', 'diamond', 'parallelogram' or 'round'
  @param {boolean} [show_secondary_image] - Show the second media on hover
  @param {boolean} [show_vendor] - Show the vendor
  @param {boolean} [show_rating] - Show the reviews-app rating when the product has one
  @param {number} [card_index] - 1-based position in the list; picks the blob variant

  @example
  {% render 'card-product', card_product: recommendation, card_index: forloop.index %}
{% enddoc %}
{%- if card_product and card_product != empty -%}
  {%- liquid
    assign ratio = 1
    if card_product.featured_media and media_aspect_ratio == 'portrait'
      assign ratio = 0.8
    elsif card_product.featured_media and media_aspect_ratio == 'adapt'
      assign ratio = card_product.featured_media.aspect_ratio
    endif
    if ratio == 0 or ratio == null
      assign ratio = 1
    endif

    case image_shape
      when 'arch'
        assign shape_classes = '[clip-path:url(#Shape-Arch)]'
      when 'blob'
        assign shape_classes = '[clip-path:polygon(var(--card-blob))] motion-safe:transition-[clip-path] motion-safe:duration-500 motion-safe:ease-in-out motion-safe:group-hover/card:[clip-path:polygon(var(--card-blob-hover))]'
      when 'chevronleft'
        assign shape_classes = '[clip-path:polygon(100%_0%,85%_50%,100%_100%,15%_100%,0%_50%,15%_0%)]'
      when 'chevronright'
        assign shape_classes = '[clip-path:polygon(85%_0%,100%_50%,85%_100%,0%_100%,15%_50%,0%_0%)]'
      when 'diamond'
        assign shape_classes = '[clip-path:polygon(50%_0%,100%_50%,50%_100%,0%_50%)]'
      when 'parallelogram'
        assign shape_classes = '[clip-path:polygon(15%_0,100%_0%,85%_100%,0%_100%)]'
      when 'round'
        assign shape_classes = '[clip-path:ellipse(45%_45%_at_50%_50%)] motion-safe:transition-[clip-path] motion-safe:duration-500 motion-safe:group-hover/card:[clip-path:ellipse(47%_47%_at_50%_50%)]'
      else
        assign shape_classes = ''
    endcase

    assign blob_base_map = '1,2,3,4,5,3,6,1,3,5' | split: ','
    assign blob_hover_map = '5,6,1,2,3,1,4,5,1,3' | split: ','
    assign blob_slot = card_index | default: 1 | minus: 1
    assign blob_base = blob_base_map[blob_slot] | default: 1
    assign blob_hover = blob_hover_map[blob_slot] | default: 5

    if show_secondary_image and card_product.media[1] != null
      assign img1_classes = 'absolute inset-0 size-full object-cover transition-opacity duration-[400ms] motion-reduce:transition-none lg:group-hover/card:opacity-0'
      assign img2_classes = 'absolute inset-0 size-full object-cover opacity-0 transition duration-500 motion-reduce:transition-none lg:group-hover/card:scale-[1.03] lg:group-hover/card:opacity-100'
    else
      assign img1_classes = 'absolute inset-0 size-full object-cover motion-safe:transition-transform motion-safe:duration-500 lg:group-hover/card:scale-[1.03]'
    endif

    assign badge_text = ''
    assign badge_color_classes = ''
    if card_product.available == false
      assign badge_text = 'products.product.sold_out' | t
      assign badge_color_classes = 'bg-foreground text-background'
    elsif card_product.compare_at_price > card_product.price and card_product.available
      assign badge_text = 'products.product.on_sale' | t
      assign badge_color_classes = 'bg-accent text-accent-foreground'
    endif
  -%}
  <div class="group/card relative" data-related-card>
    <div
      class="relative aspect-(--card-aspect)"
      style="--card-aspect: {{ ratio }}{% if image_shape == 'blob' %}; --card-blob: var(--shape--blob-{{ blob_base }}); --card-blob-hover: var(--shape--blob-{{ blob_hover }}){% endif %}"
      data-card-media
    >
      <div class="absolute inset-0 overflow-hidden {{ shape_classes }}" data-card-image-box>
        {%- if card_product.featured_media -%}
          {% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
          <img
            srcset="
              {%- if card_product.featured_media.width >= 165 -%}{{ card_product.featured_media | image_url: width: 165 }} 165w,{%- endif -%}
              {%- if card_product.featured_media.width >= 360 -%}{{ card_product.featured_media | image_url: width: 360 }} 360w,{%- endif -%}
              {%- if card_product.featured_media.width >= 533 -%}{{ card_product.featured_media | image_url: width: 533 }} 533w,{%- endif -%}
              {%- if card_product.featured_media.width >= 720 -%}{{ card_product.featured_media | image_url: width: 720 }} 720w,{%- endif -%}
              {%- if card_product.featured_media.width >= 940 -%}{{ card_product.featured_media | image_url: width: 940 }} 940w,{%- endif -%}
              {%- if card_product.featured_media.width >= 1066 -%}{{ card_product.featured_media | image_url: width: 1066 }} 1066w,{%- endif -%}
              {{ card_product.featured_media | image_url }} {{ card_product.featured_media.width }}w
            "
            src="{{ card_product.featured_media | image_url: width: 533 }}"
            sizes="(min-width: 1200px) 267px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
            alt="{{ card_product.featured_media.alt | escape }}"
            class="{{ img1_classes }}"
            loading="lazy"
            width="{{ card_product.featured_media.width }}"
            height="{{ card_product.featured_media.height }}"
          >
          {% comment %}theme-check-enable ImgLazyLoading{% endcomment %}

          {%- if card_product.media[1] != null and show_secondary_image -%}
            <img
              srcset="
                {%- if card_product.media[1].width >= 165 -%}{{ card_product.media[1] | image_url: width: 165 }} 165w,{%- endif -%}
                {%- if card_product.media[1].width >= 360 -%}{{ card_product.media[1] | image_url: width: 360 }} 360w,{%- endif -%}
                {%- if card_product.media[1].width >= 533 -%}{{ card_product.media[1] | image_url: width: 533 }} 533w,{%- endif -%}
                {%- if card_product.media[1].width >= 720 -%}{{ card_product.media[1] | image_url: width: 720 }} 720w,{%- endif -%}
                {%- if card_product.media[1].width >= 940 -%}{{ card_product.media[1] | image_url: width: 940 }} 940w,{%- endif -%}
                {%- if card_product.media[1].width >= 1066 -%}{{ card_product.media[1] | image_url: width: 1066 }} 1066w,{%- endif -%}
                {{ card_product.media[1] | image_url }} {{ card_product.media[1].width }}w
              "
              src="{{ card_product.media[1] | image_url: width: 533 }}"
              sizes="(min-width: 1200px) 267px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
              alt="{{ card_product.media[1].alt | escape }}"
              class="{{ img2_classes }}"
              loading="lazy"
              width="{{ card_product.media[1].width }}"
              height="{{ card_product.media[1].height }}"
            >
          {%- endif -%}
        {%- else -%}
          {{ 'product-apparel-2' | placeholder_svg_tag: 'absolute inset-0 size-full' }}
        {%- endif -%}
      </div>
      {%- if badge_text != blank -%}
        <span id="Badge-{{ card_product.id }}" class="absolute bottom-2.5 left-2.5 border border-transparent px-[0.8125rem] pt-[0.3125rem] pb-[0.375rem] text-center text-[0.75rem] leading-none tracking-[0.0625rem] {{ badge_color_classes }}" data-card-badge>
          {{- badge_text -}}
        </span>
      {%- endif -%}
    </div>
    <div class="flex flex-col gap-[0.4375rem] py-[0.8125rem] md:py-[1.0625rem]">
      <h3 class="m-0">
        <a
          href="{{ card_product.url }}"
          id="CardLink-{{ card_product.id }}"
          class="block no-underline after:absolute after:inset-0 after:z-1 focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-offset-2 focus-visible:after:outline-current lg:group-hover/card:underline lg:group-hover/card:underline-offset-[0.1875rem]"
          aria-labelledby="CardLink-{{ card_product.id }} Badge-{{ card_product.id }}"
        >
          {{ card_product.title | escape }}
        </a>
      </h3>
      <div class="flex flex-col gap-[0.4375rem]">
        {%- if show_vendor -%}
          <span class="sr-only">{{ 'accessibility.vendor' | t }}</span>
          <div class="text-[0.625rem] tracking-[0.08125rem] uppercase opacity-70">{{ card_product.vendor }}</div>
        {%- endif -%}

        {%- if show_rating and card_product.metafields.reviews.rating.value != blank -%}
          {%- liquid
            assign rating_percent = card_product.metafields.reviews.rating.value.rating | times: 100.0 | divided_by: card_product.metafields.reviews.rating.value.scale_max | round
          -%}
          <div
            role="img"
            aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: card_product.metafields.reviews.rating.value, rating_max: card_product.metafields.reviews.rating.value.scale_max }}"
          >
            <span
              aria-hidden="true"
              class="inline-block font-[Times] text-[0.875rem] leading-none tracking-[0.4375rem] forced-colors:hidden before:bg-[linear-gradient(90deg,var(--color-foreground)_var(--rating-percent),color-mix(in_oklab,var(--color-foreground)_15%,transparent)_var(--rating-percent))] before:bg-clip-text before:text-transparent before:content-['★★★★★']"
              style="--rating-percent: {{ rating_percent }}%"
            ></span>
          </div>
          <p class="m-0 text-[0.625rem] not-forced-colors:hidden">
            <span aria-hidden="true">
              {{- card_product.metafields.reviews.rating.value }} /
              {{ card_product.metafields.reviews.rating.value.scale_max -}}
            </span>
          </p>
          <p class="m-0 inline-block text-[0.625rem] md:text-[0.75rem]">
            <span aria-hidden="true">({{ card_product.metafields.reviews.rating_count }})</span>
            <span class="sr-only">
              {{- card_product.metafields.reviews.rating_count }}
              {{ 'accessibility.total_reviews' | t -}}
            </span>
          </p>
        {%- endif -%}

        {% render 'price', product: card_product, show_compare_at_price: true %}
        {%- if card_product.quantity_price_breaks_configured? -%}
          <div class="text-[0.625rem] md:text-[0.75rem] tracking-[0.04375rem]" data-volume-pricing-note>{{ 'products.product.volume_pricing.note' | t }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}
