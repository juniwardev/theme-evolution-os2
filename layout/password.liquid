<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {%- comment -%} Fixes the cascade-layer order before any stylesheet; keep it first. See docs/plans/theme-evolution-tailwind.md D4. {%- endcomment -%}
    <style>@layer properties, theme, base, components, utilities;</style>

    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Tailwind CSS, compiled from src/tailwind.css %}
    {{ 'tailwind.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    {{ content_for_layout }}
  </body>
</html>
