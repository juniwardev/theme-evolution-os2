{% if settings.enable_cart_drawer %}
  <cart-drawer class="group/drawer block" data-state="closed" hidden>
    <div id="CartDrawer" class="cart-drawer__inner fixed top-0 left-0 z-1000 flex h-screen w-screen justify-end">
      <div class="absolute top-0 left-0 block size-full cursor-pointer bg-black/50 opacity-0 transition-opacity duration-300 ease-[ease] group-data-[state=open]/drawer:opacity-100" data-cart-drawer-close></div>
      <div class="relative flex h-full w-full max-w-[25rem] translate-x-full flex-col bg-background shadow-[-5px_0_15px_rgb(0_0_0/0.1)] transition-transform duration-300 ease-[cubic-bezier(0.19,1,0.22,1)] group-data-[state=open]/drawer:translate-x-0" role="dialog" aria-modal="true" aria-label="{{ 'cart.title' | t }}">
        <div class="flex items-center justify-between border-b border-foreground/10 p-5">
          <h2 class="m-0 font-heading text-[1.25rem] leading-tight font-bold uppercase">{{ 'cart.title' | t }}</h2>
          <button class="text-[2rem] leading-none" type="button" data-cart-drawer-close aria-label="{{ 'cart.close' | t }}">
            &times;
          </button>
        </div>

        {% render 'cart-intelligence-banner' %}

        <div class="flex-1 overflow-y-auto p-5" id="CartDrawer-CartItems">
          {%- if cart == empty -%}
            <div class="flex flex-col items-start gap-4">
              <p>{{ 'cart.empty' | t }}</p>
              <a href="{{ routes.all_products_collection_url }}" class="btn-primary">
                {{ 'general.continue_shopping' | t }}
              </a>
            </div>
          {%- else -%}
            <form action="{{ routes.cart_url }}" id="CartDrawer-Form" method="post">
              <div>
                {%- for item in cart.items -%}
                  <div class="mb-5 flex gap-3.75 border-b border-foreground/6 pb-5" data-cart-drawer-item>
                    {%- if item.image -%}
                      <div>
                        <img src="{{ item.image | image_url: width: 150 }}" alt="{{ item.image.alt | escape }}" loading="lazy" width="150" height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}" class="h-auto w-20 rounded-sm object-cover">
                      </div>
                    {%- endif -%}
                    <div class="flex min-w-0 flex-1 flex-col">
                      <a href="{{ item.url }}" class="mb-1.25 font-semibold text-foreground no-underline">{{ item.product.title | escape }}</a>
                      <div class="mb-2.5">
                        {{ item.final_line_price | money }}
                      </div>
                      <div>
                        <label class="sr-only" for="Drawer-quantity-{{ item.index | plus: 1 }}">
                          {{ 'products.product.quantity.label' | t }}
                        </label>
                        <input class="cart-drawer__quantity-input mb-2.5 w-15 rounded-input border border-foreground/25 p-1.25"
                          type="number"
                          name="updates[]"
                          value="{{ item.quantity }}"
                          min="0"
                          aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                          id="Drawer-quantity-{{ item.index | plus: 1 }}"
                          data-index="{{ item.index | plus: 1 }}"
                        >
                      </div>
                      <a href="{{ item.url_to_remove }}" class="cart-drawer__item-remove text-[0.85rem] text-[#d32f2f] underline" data-index="{{ item.index | plus: 1 }}">
                        {{ 'cart.remove' | t }}
                      </a>
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            </form>
          {%- endif -%}
        </div>

        {%- if cart != empty -%}
          <div class="border-t border-foreground/10 bg-foreground/2 p-5" data-cart-drawer-footer>
            <div class="mb-3.75 flex items-center justify-between">
              <h3 class="m-0 text-[1.1rem]">{{ 'sections.cart.headings.total' | t }}</h3>
              <p class="m-0 text-[1.25rem] font-bold">{{ cart.total_price | money_with_currency }}</p>
            </div>
            <div>
              <button type="submit" id="CartDrawer-Checkout" class="btn-primary w-full" name="checkout" form="CartDrawer-Form">
                {{ 'cart.checkout' | t }}
              </button>
            </div>
          </div>
        {%- endif -%}

        <div class="invisible absolute inset-0 flex items-center justify-center bg-background/60 group-aria-busy/drawer:visible" data-cart-drawer-busy>
          {% render 'spinner', size: 'lg' %}
        </div>
      </div>
    </div>
  </cart-drawer>

  <style>
    @layer components {
      body:has(cart-drawer[data-state='open']) {
        overflow: hidden;
      }
    }
  </style>

  <script>
    class AjaxCartDrawer extends HTMLElement {
      constructor() {
        super();
        this.drawer = this;
        this.bindEvents();
      }

      bindEvents() {
        document.querySelectorAll('[data-cart-drawer-trigger]').forEach((trigger) => {
          const newTrigger = trigger.cloneNode(true);
          if (trigger.parentNode) {
            trigger.parentNode.replaceChild(newTrigger, trigger);
          }
          newTrigger.addEventListener('click', (e) => {
            e.preventDefault();
            this.open();
          });
        });

        this.querySelectorAll('[data-cart-drawer-close]').forEach((trigger) => {
          trigger.addEventListener('click', (e) => {
            e.preventDefault();
            this.close();
          });
        });

        this.querySelectorAll('.cart-drawer__quantity-input').forEach((input) => {
          input.addEventListener('change', (e) => {
            this.updateLineItem(input.dataset.index, input.value);
          });
        });

        this.querySelectorAll('.cart-drawer__item-remove').forEach((link) => {
          link.addEventListener('click', (e) => {
            e.preventDefault();
            this.updateLineItem(link.dataset.index, 0);
          });
        });

        document.addEventListener('keyup', (e) => {
          if (e.code === 'Escape') this.close();
        });
      }

      open() {
        this.drawer.hidden = false;
        setTimeout(() => {
          this.drawer.dataset.state = 'open';
        }, 10);
      }

      close() {
        this.drawer.dataset.state = 'closed';
        setTimeout(() => {
          this.drawer.hidden = true;
        }, 300);
      }

      getSectionsToRender() {
        return [
          {
            id: 'cart-drawer',
            selector: '.cart-drawer__inner'
          },
          {
            id: 'header',
            selector: '[data-header-cart-icon]'
          }
        ];
      }

      setActiveElement(element) {
        this.activeElement = element;
      }

      renderContents(parsedState) {
        if (!parsedState || !parsedState.sections) {
          this.updateCart();
          return;
        }

        this.getSectionsToRender().forEach((section) => {
          const html = parsedState.sections[section.id];
          if (!html) return;
          
          const parsedHTML = new DOMParser().parseFromString(html, 'text/html');
          const newContent = parsedHTML.querySelector(section.selector);
          
          const sectionElement = section.id === 'header' 
            ? document.querySelector(section.selector) 
            : this.querySelector(section.selector);
            
          if (newContent && sectionElement) {
            sectionElement.innerHTML = newContent.innerHTML;
          }
          if (section.id === 'header' && newContent && sectionElement) {
            // Why: the cart link's own aria-label carries the count; innerHTML alone left it stale.
            const label = newContent.getAttribute('aria-label');
            if (label !== null) sectionElement.setAttribute('aria-label', label);
          }
        });
        
        this.bindEvents();
        this.open();
      }

      updateLineItem(line, quantity) {
        this.drawer.setAttribute('aria-busy', 'true');

        const body = JSON.stringify({
          line: line,
          quantity: quantity,
          sections: this.getSectionsToRender().map((s) => s.id).join(','),
          sections_url: window.location.pathname
        });

        fetch(window.routes.cart_change_url || '/cart/change.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/javascript'
          },
          body
        })
        .then((response) => response.json())
        .then((parsedState) => {
          this.drawer.removeAttribute('aria-busy');
          this.renderContents(parsedState);
        })
        .catch((error) => {
          console.error('Error updating line item:', error);
          this.drawer.removeAttribute('aria-busy');
          this.updateCart();
        });
      }

      updateCart() {
        fetch('/?section_id=cart-drawer')
          .then((response) => response.text())
          .then((html) => {
            const parsedHTML = new DOMParser().parseFromString(html, 'text/html');
            const newDrawerInner = parsedHTML.querySelector('.cart-drawer__inner');
            if (newDrawerInner) {
              this.querySelector('.cart-drawer__inner').innerHTML = newDrawerInner.innerHTML;
              this.bindEvents();
              this.open();
            }
          })
          .catch((error) => console.error('Error updating cart drawer:', error));

        fetch('/?section_id=header')
          .then((response) => response.text())
          .then((html) => {
            const parsedHTML = new DOMParser().parseFromString(html, 'text/html');
            const newHeaderIcon = parsedHTML.querySelector('[data-header-cart-icon]');
            const currentHeaderIcon = document.querySelector('[data-header-cart-icon]');
            if (newHeaderIcon && currentHeaderIcon) {
              currentHeaderIcon.innerHTML = newHeaderIcon.innerHTML;
              // Why: keep the link's own aria-label in step with its badge.
              const label = newHeaderIcon.getAttribute('aria-label');
              if (label !== null) currentHeaderIcon.setAttribute('aria-label', label);
            }
          })
          .catch((e) => console.error('Error updating header icon:', e));
      }
    }

    if (!customElements.get('cart-drawer')) {
      customElements.define('cart-drawer', AjaxCartDrawer);
    }
  </script>
{% endif %}

{% schema %}
{
  "name": "Cart Drawer",
  "settings": []
}
{% endschema %}