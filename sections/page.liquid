{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

<div class="flex flex-col gap-8 px-8 py-10 md:py-16" data-page-shell>
  <h1 class="font-heading text-3xl leading-tight font-bold uppercase md:text-4xl">{{ page.title | escape }}</h1>

  {%- if page.content != blank -%}
    {% # Shopify's privacy opt-out widget is wider than a phone column. It scrolls inside this box, not the page. %}
    <div class="prose prose-tokens overflow-x-auto" data-rich-text>{{ page.content }}</div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:general.page",
  "settings": []
}
{% endschema %}
