{% comment %}
  This section is used in the list-collections template to render a list of
  collections.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

{%- liquid
  if section.settings.grid_item_width == 'collections--compact'
    assign grid_min = '10rem'
  else
    assign grid_min = '17.5rem'
  endif
-%}

<div class="flex flex-col gap-8 px-8 py-10 md:py-16" data-page-shell>
  <h1 class="font-heading text-3xl leading-tight font-bold uppercase md:text-4xl">{{ 'collections.title' | t }}</h1>

  <div class="mb-0 grid grid-fill gap-(--grid-gap)" style="--grid-min: {{ grid_min }}; --grid-gap: {{ section.settings.grid_gap }}px">
    {% for collection in collections %}
      <a class="flex w-full flex-col" href="{{ collection.url }}">
        {% if collection.featured_image %}
          {% render 'image',
            image: collection.featured_image,
            width: 600,
            height: 600,
            crop: 'center'
          %}
        {% endif %}

        <div>
          <p>{{ collection.title | escape }}</p>

          {% if collection.description %}
            <p>{{ collection.description | strip_html | truncatewords: 15 }}</p>
          {% endif %}
        </div>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "t:general.collections_grid",
  "settings": [
    {
      "type": "select",
      "id": "grid_item_width",
      "label": "t:labels.grid_item_width",
      "options": [
        { "value": "collections--compact", "label": "t:options.size.small" },
        { "value": "collections--full", "label": "t:options.size.large" }
      ],
      "default": "collections--full"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "t:labels.grid_gap",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 10
    }
  ],
  "presets": [{ "name": "t:general.collections_grid" }]
}
{% endschema %}
