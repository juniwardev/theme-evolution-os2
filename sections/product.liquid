{% comment %}
  Renders the main product section with customizable blocks.

  @example
  {% section 'product' %}
{% endcomment %}

<script src="{{ 'material-api-fetch.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

<div class="mx-auto flex w-full max-w-page flex-col gap-8 px-6 md:flex-row md:items-start md:gap-0 md:px-20">
  <div class="md:max-w-[50%] md:flex-[1_1_50%] lg:max-w-[55%] lg:flex-[1_1_55%]">
    {%- for image in product.images -%}
      {%- if forloop.first -%}
        {%- if section.index == 1 -%}
          {{ image | image_url: width: 1000 | image_tag: class: 'block h-auto w-full rounded-lg', loading: 'eager', fetchpriority: 'high', preload: true }}
        {%- else -%}
          {{ image | image_url: width: 1000 | image_tag: class: 'block h-auto w-full rounded-lg', loading: 'eager' }}
        {%- endif -%}
      {%- else -%}
        {{ image | image_url: width: 1000 | image_tag: class: 'block h-auto w-full rounded-lg', loading: 'lazy' }}
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="flex min-w-0 flex-col gap-4 md:max-w-[50%] md:flex-[1_1_50%] md:pl-20 lg:max-w-[45%] lg:flex-[1_1_45%] lg:pl-16">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when '@app' -%}
          {% render block %}

        {%- when 'text' -%}
          <div {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </div>

        {%- when 'title' -%}
          <h1 class="font-heading text-3xl leading-tight font-bold uppercase md:text-4xl" {{ block.shopify_attributes }}>
            {{ product.title | escape }}
          </h1>

        {%- when 'price' -%}
          <div {{ block.shopify_attributes }}>
            {{ product.price | money }}
          </div>

        {%- when 'description' -%}
          <div {{ block.shopify_attributes }}>
            {%- assign sustainable_materials = "Mycelium Bio-Fabric,Organic Cotton,Recycled Polyester" | split: "," -%}
            {%- assign description_with_tooltips = product.description -%}
            {%- for material in sustainable_materials -%}
              {%- assign material_handle = material | handleize -%}
              {%- assign trigger_span = '<span class="eco-tooltip-trigger cursor-help font-medium text-[#00707c] underline decoration-dotted underline-offset-4 transition-colors duration-200 hover:text-[#004c55] hover:decoration-solid" data-material-handle="' | append: material_handle | append: '">' | append: material | append: '</span>' -%}
              {%- assign description_with_tooltips = description_with_tooltips | replace: material, trigger_span -%}
            {%- endfor -%}
            {{ description_with_tooltips }}
          </div>

          <details id="MaterialAccordion" class="group/acc my-4 border-y border-foreground/10 py-6">
            <summary class="flex cursor-pointer list-none items-center justify-between text-[1.1rem] font-semibold select-none [&::-webkit-details-marker]:hidden">
              {{ 'sections.product.material_specs' | t }}
              <span class="text-[1.5rem] font-normal transition-transform duration-300 group-open/acc:rotate-45">+</span>
            </summary>
            <div id="material-data-container" class="flex items-start gap-6 pt-6 [&_.material-accordion\_\_thumbnail]:h-auto [&_.material-accordion\_\_thumbnail]:max-w-[100px] [&_.material-accordion\_\_thumbnail]:shrink-0 [&_.material-accordion\_\_thumbnail]:rounded-lg [&_.material-accordion\_\_thumbnail]:border [&_.material-accordion\_\_thumbnail]:border-foreground/5 [&_.material-accordion\_\_story]:m-0 [&_.material-accordion\_\_story]:grow [&_.material-accordion\_\_story]:leading-[1.6] [&_.material-accordion\_\_story]:text-foreground">
              <div class="flex items-center gap-2 italic text-foreground/75">
                {{ 'sections.product.material_specs_loading' | t }}
              </div>
            </div>
          </details>

        {%- when 'variant_picker' -%}
          {%- if product.variants.size > 1 -%}
            <div {{ block.shopify_attributes }}>
              <select name="id" class="h-11 w-full min-w-0 rounded-input border border-current bg-background px-3">
                {% for variant in product.variants %}
                  <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected="selected"{% endif %}>
                    {{ variant.title }} - {{ variant.price | money }}
                  </option>
                {% endfor %}
              </select>
            </div>
          {%- endif -%}

        {%- when 'quantity_selector' -%}
          <div class="flex items-center gap-3" {{ block.shopify_attributes }}>
            <label for="Quantity-{{ section.id }}">{{ 'products.product.quantity.label' | t }}</label>
            <input type="number" id="Quantity-{{ section.id }}" name="quantity" min="1" value="1" class="h-11 w-20 rounded-input border border-current bg-transparent px-3">
          </div>

        {%- when 'buy_buttons' -%}
          <div {{ block.shopify_attributes }}>
            <product-form>
              {% form 'product', product, class: 'flex flex-col gap-3' %}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button type="submit" name="add" class="btn-primary relative w-full [&.loading>span]:invisible">
                  <span>{{ 'products.product.add_to_cart' | t }}</span>
                  <div class="loading__spinner hidden absolute inset-0 size-full">
                    {% render 'spinner', css_class: 'absolute inset-0 m-auto' %}
                  </div>
                </button>
                {% if block.settings.show_dynamic_checkout %}
                  {{ form | payment_button }}
                {% endif %}
              {% endform %}
            </product-form>
          </div>

        {%- when 'share' -%}
          <div {{ block.shopify_attributes }}>
            <button type="button" class="btn-secondary">{{ block.settings.share_label | escape }}</button>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  @layer components {
    .eco-tooltip {
      position: absolute;
      top: 0;
      left: 0;
      z-index: 9999;
      display: block;
      visibility: hidden;
      opacity: 0;
      pointer-events: none;
      min-width: 200px;
      max-width: 320px;
      padding: 1.25rem;
      border: 1px solid #e0e0e0;
      border-radius: 4px;
      background-color: #ffffff;
      box-shadow: 0 10px 25px rgb(0 0 0 / 0.1);
      transform: translateY(5px);
      transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
    }
    .eco-tooltip.is-visible {
      visibility: visible;
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Text block",
          "label": "Text"
        }
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "picker_type",
          "options": [
            {
              "value": "dropdown",
              "label": "Dropdown"
            },
            {
              "value": "button",
              "label": "Button"
            }
          ],
          "default": "button",
          "label": "Picker type"
        }
      ]
    },
    {
      "type": "quantity_selector",
      "name": "Quantity selector",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "default": true,
          "label": "Show dynamic checkout buttons"
        },
        {
          "type": "checkbox",
          "id": "show_gift_card_recipient",
          "default": true,
          "label": "Show recipient information form for gift cards"
        }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "share",
      "name": "Share",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "share_label",
          "label": "Share label",
          "default": "Share"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}