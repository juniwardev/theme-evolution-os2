{%- liquid
  assign has_menu = false
  if section.settings.menu != blank and section.settings.menu.links.size > 0
    assign has_menu = true
  endif

  assign has_social = false
  if section.settings.show_social_icons
    if section.settings.instagram_url != blank
      assign has_social = true
    elsif section.settings.facebook_url != blank
      assign has_social = true
    elsif section.settings.youtube_url != blank
      assign has_social = true
    elsif section.settings.tiktok_url != blank
      assign has_social = true
    elsif section.settings.twitter_url != blank
      assign has_social = true
    endif
  endif

  assign has_about = false
  if section.settings.about_text != blank
    assign has_about = true
  endif

  assign social_label = 'sections.footer.social.aria_label' | t
  assign payment_label = 'sections.footer.payment' | t
  assign menu_label = 'sections.footer.menu' | t
-%}

<div
  class="theme-evolution-footer-wrapper col-span-full bg-(--footer-bg) text-(--footer-text)"
  style="--footer-bg: {{ section.settings.footer_background }}; --footer-text: {{ section.settings.footer_text }}"
>
  <footer class="theme-evolution-footer px-6 pt-12 pb-6 md:px-8 md:pt-16 md:pb-8">
    {%- if has_about or has_menu or has_social -%}
      <div class="theme-evolution-footer__columns mb-0 grid grid-cols-1 gap-8 pb-8 md:grid-cols-[2fr_1fr_1fr] md:gap-12 md:pb-12">
        {%- if has_about -%}
          <div class="theme-evolution-footer__column theme-evolution-footer__column--about">
            <div class="theme-evolution-footer__about-text max-w-none text-sm/[1.6] md:max-w-lg [&_p]:mb-3 [&_p:last-child]:mb-0">
              {{ section.settings.about_text }}
            </div>
          </div>
        {%- endif -%}

        {%- if has_menu -%}
          <nav class="theme-evolution-footer__column theme-evolution-footer__column--menu" aria-label="{{ menu_label | escape }}">
            <ul class="theme-evolution-footer__menu flex flex-col gap-3" role="list">
              {%- for link in section.settings.menu.links -%}
                <li>
                  <a href="{{ link.url }}" class="theme-evolution-footer__menu-link text-sm tracking-[0.08em] uppercase no-underline hover:underline">{{ link.title | escape }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}

        {%- if has_social -%}
          <div class="theme-evolution-footer__column theme-evolution-footer__column--social">
            <ul class="theme-evolution-footer__social flex items-center gap-4" role="list" aria-label="{{ social_label | escape }}">
              {%- if section.settings.instagram_url != blank -%}
                <li>
                  <a href="{{ section.settings.instagram_url }}" class="theme-evolution-footer__social-link inline-flex size-10 items-center justify-center no-underline hover:underline [&_svg]:size-5.5 [&_svg]:fill-current" aria-label="{{ 'sections.footer.social.instagram' | t }}, {{ 'accessibility.link_messages.new_window' | t }}" rel="noopener" target="_blank">
                    {{ 'icon-instagram.svg' | inline_asset_content }}
                  </a>
                </li>
              {%- endif -%}
              {%- if section.settings.facebook_url != blank -%}
                <li>
                  <a href="{{ section.settings.facebook_url }}" class="theme-evolution-footer__social-link inline-flex size-10 items-center justify-center no-underline hover:underline [&_svg]:size-5.5 [&_svg]:fill-current" aria-label="{{ 'sections.footer.social.facebook' | t }}, {{ 'accessibility.link_messages.new_window' | t }}" rel="noopener" target="_blank">
                    {{ 'icon-facebook.svg' | inline_asset_content }}
                  </a>
                </li>
              {%- endif -%}
              {%- if section.settings.youtube_url != blank -%}
                <li>
                  <a href="{{ section.settings.youtube_url }}" class="theme-evolution-footer__social-link inline-flex size-10 items-center justify-center no-underline hover:underline [&_svg]:size-5.5 [&_svg]:fill-current" aria-label="{{ 'sections.footer.social.youtube' | t }}, {{ 'accessibility.link_messages.new_window' | t }}" rel="noopener" target="_blank">
                    {{ 'icon-youtube.svg' | inline_asset_content }}
                  </a>
                </li>
              {%- endif -%}
              {%- if section.settings.tiktok_url != blank -%}
                <li>
                  <a href="{{ section.settings.tiktok_url }}" class="theme-evolution-footer__social-link inline-flex size-10 items-center justify-center no-underline hover:underline [&_svg]:size-5.5 [&_svg]:fill-current" aria-label="{{ 'sections.footer.social.tiktok' | t }}, {{ 'accessibility.link_messages.new_window' | t }}" rel="noopener" target="_blank">
                    {{ 'icon-tiktok.svg' | inline_asset_content }}
                  </a>
                </li>
              {%- endif -%}
              {%- if section.settings.twitter_url != blank -%}
                <li>
                  <a href="{{ section.settings.twitter_url }}" class="theme-evolution-footer__social-link inline-flex size-10 items-center justify-center no-underline hover:underline [&_svg]:size-5.5 [&_svg]:fill-current" aria-label="{{ 'sections.footer.social.twitter' | t }}, {{ 'accessibility.link_messages.new_window' | t }}" rel="noopener" target="_blank">
                    {{ 'icon-twitter.svg' | inline_asset_content }}
                  </a>
                </li>
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="theme-evolution-footer__bottom flex flex-col items-center gap-4 border-t border-current/8 pt-8 text-center md:flex-row md:flex-wrap md:justify-between md:text-left">
      <p class="theme-evolution-footer__copyright m-0 text-sm opacity-85 [&_a]:no-underline [&_a:hover]:underline">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }} &middot; {{ powered_by_link }}
      </p>

      {%- if section.settings.show_payment_icons -%}
        <ul class="theme-evolution-footer__payment flex flex-wrap items-center gap-2" role="list" aria-label="{{ payment_label | escape }}">
          {%- for type in shop.enabled_payment_types -%}
            <li class="inline-flex [&_svg]:h-6.5 [&_svg]:w-auto">{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </footer>
</div>

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__color.content"
    },
    {
      "type": "color",
      "id": "footer_background",
      "label": "t:sections.footer.settings.footer_background.label",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "footer_text",
      "label": "t:sections.footer.settings.footer_text.label",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__content.content"
    },
    {
      "type": "richtext",
      "id": "about_text",
      "label": "t:sections.footer.settings.about_text.label",
      "info": "t:sections.footer.settings.about_text.info",
      "default": "<p>We're passionate about bringing you the best products. Our story started with a simple idea and a commitment to quality.</p>"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__social.content"
    },
    {
      "type": "checkbox",
      "id": "show_social_icons",
      "label": "t:sections.footer.settings.show_social_icons.label",
      "default": true
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "t:sections.footer.settings.instagram_url.label"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "t:sections.footer.settings.facebook_url.label"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "t:sections.footer.settings.youtube_url.label"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "t:sections.footer.settings.tiktok_url.label"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "t:sections.footer.settings.twitter_url.label"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__payment.content"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ]
}
{% endschema %}
