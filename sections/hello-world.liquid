<div class="col-span-full mb-0 grid grid-cols-(--content-grid) bg-[#f6f6f7] py-18 text-[#333333]" data-hello-band>
  <div class="col-start-2 flex w-full items-center justify-between gap-4 px-8">
    <div>
      <h1 class="font-heading text-3xl leading-tight font-bold uppercase md:text-4xl">
        {{ 'sections.hello_world.heading' | t }}
      </h1>

      <p class="mt-6 max-w-[80ch] leading-[1.4]">{{ 'sections.hello_world.description_intro' | t }}</p>

      <p class="mt-6 max-w-[80ch] leading-[1.4]">{{ 'sections.hello_world.description_themes' | t }}</p>
    </div>
    <div class="w-[300px]">
      <img src="{{ 'shoppy-x-ray.svg' | asset_url }}" width="300" height="300" alt="">
    </div>
  </div>
</div>

<div class="mt-12.5 mb-0 grid grid-cols-1 gap-8 px-8 lg:grid-cols-3" data-hello-cards>
  <div class="flex flex-col gap-4 rounded-lg bg-[#eef3ff] p-6 leading-[1.4] text-[#5c5f62]" data-hello-card>
    <h2 class="m-0 text-[1rem] text-[#202223]">{{ 'sections.hello_world.concepts_title' | t }}</h2>
    <p class="m-0 flex-1">{{ 'sections.hello_world.concepts_text' | t }}</p>
    <p class="m-0">
      {{
        'sections.hello_world.concepts_link'
        | t
        | link_to: 'https://shopify.dev/docs/storefronts/themes/architecture', class: 'flex w-fit rounded-sm border border-[#8c9196] bg-[#fafbfb] px-2.5 pt-[3px] pb-[5px] text-[#5c5f62] no-underline shadow-[inset_0_-3px_0_0_rgb(0_0_0/0.2),inset_0_2px_0_0_rgb(255_255_255/0.9)]'
      }}
    </p>
  </div>

  <div class="flex flex-col gap-4 rounded-lg bg-[#eef3ff] p-6 leading-[1.4] text-[#5c5f62]" data-hello-card>
    <h2 class="m-0 text-[1rem] text-[#202223]">{{ 'sections.hello_world.liquid_title' | t }}</h2>
    <p class="m-0 flex-1">{{ 'sections.hello_world.liquid_text' | t }}</p>
    <p class="m-0">
      {{
        'sections.hello_world.liquid_link'
        | t
        | link_to: 'https://shopify.dev/docs/api/liquid', class: 'flex w-fit rounded-sm border border-[#8c9196] bg-[#fafbfb] px-2.5 pt-[3px] pb-[5px] text-[#5c5f62] no-underline shadow-[inset_0_-3px_0_0_rgb(0_0_0/0.2),inset_0_2px_0_0_rgb(255_255_255/0.9)]'
      }}
    </p>
  </div>

  <div class="flex flex-col gap-4 rounded-lg bg-[#eef3ff] p-6 leading-[1.4] text-[#5c5f62]" data-hello-card>
    <h2 class="m-0 text-[1rem] text-[#202223]">{{ 'sections.hello_world.practices_title' | t }}</h2>
    <p class="m-0 flex-1">{{ 'sections.hello_world.practices_text' | t }}</p>
    <p class="m-0">
      {{
        'sections.hello_world.practices_link'
        | t
        | link_to: 'https://shopify.dev/docs/storefronts/themes/best-practices', class: 'flex w-fit rounded-sm border border-[#8c9196] bg-[#fafbfb] px-2.5 pt-[3px] pb-[5px] text-[#5c5f62] no-underline shadow-[inset_0_-3px_0_0_rgb(0_0_0/0.2),inset_0_2px_0_0_rgb(255_255_255/0.9)]'
      }}
    </p>
  </div>
</div>

{% schema %}
{
  "name": "Hello world",
  "settings": [],
  "presets": [
    {
      "name": "Hello world template",
      "category": "Demo"
    }
  ]
}
{% endschema %}
