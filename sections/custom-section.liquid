<div class="relative col-span-full w-full overflow-hidden">
  {% if section.settings.background_image %}
    <div class="absolute -z-1 size-full overflow-hidden">
      {{ section.settings.background_image | image_url: width: 2000 | image_tag: preload: true, class: 'absolute top-1/2 left-1/2 h-auto w-full -translate-x-1/2 -translate-y-1/2' }}
    </div>
  {% endif %}

  <div class="mb-0 grid grid-cols-(--content-grid) [&>*]:col-start-2">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'trust_badge' -%}
          {% render 'trust-badge', block: block %}

        {%- when 'specs_table' -%}
          {% render 'specs-table', block: block %}

        {%- when 'material_highlight' -%}
          {% render 'material-info', material: product.metafields.custom.material_link.value %}
        
        {%- when '@app' -%}
          {% render block %}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Custom section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "trust_badge",
      "name": "Trust badge",
      "settings": [
        {
          "type": "select",
          "id": "style",
          "label": "Badge style",
          "options": [
            { "value": "minimal", "label": "Minimal" },
            { "value": "pill", "label": "Pill" },
            { "value": "underline", "label": "Underline" }
          ],
          "default": "underline"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Badge text",
          "default": "Free shipping on all orders"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#000000"
        }
      ]
    },
    {
      "type": "specs_table",
      "name": "Technical specifications",
      "settings": [
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#000000"
        }
      ]
    },
    {
      "type": "material_highlight",
      "name": "Material Highlight",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Displays detailed info from the linked Material Metaobject (custom.material_link)."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.custom_section",
      "blocks": [
        {
          "type": "trust_badge"
        }
      ]
    }
  ]
}
{% endschema %}